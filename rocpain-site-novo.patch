+.services h3 { margin: 0 0 4px; font-size: 1.1875rem; font-weight: 700; }
+.services p { margin: 0; color: var(--muted); }
+
+
+/* AI block gets the one inverted surface on the page */
+.ai { background: var(--gold); color: var(--bg); margin-top: clamp(64px, 9vw, 112px); padding: clamp(56px, 8vw, 96px) 0; }
