+.featured .game-title { font-size: clamp(1.75rem, 3.4vw, 2.5rem); }
+.game-meta { color: var(--muted); font-size: .9375rem; margin: 0 0 12px; }
+.game-desc { margin: 0 0 18px; }
+@media (max-width: 820px) { .featured { grid-template-columns: minmax(0,1fr); } }
+
+.games { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 36px 32px; margin-top: 40px; }
+.game img { border-radius: 12px; aspect-ratio: 460 / 215; object-fit: cover; width: 100%; background: var(--bg-raised); }
+.game .game-title { margin-top: 16px; font-size: 1.375rem; }
+.game .game-desc { font-size: 1rem; }
+.note { margin: -6px 0 14px; padding-left: 12px; border-left: 3px solid var(--crimson); color: var(--muted); font-size: .9375rem; }
