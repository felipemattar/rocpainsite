+.contact-list a:hover { color: var(--gold); }
+.contact-list svg { width: 22px; height: 22px; flex: none; fill: var(--gold); }
+@media (max-width: 760px) { .contact-box { grid-template-columns: 1fr; } }
 
+footer { border-top: 1px solid var(--line); padding: 28px 0 40px; color: var(--muted); font-size: .9375rem; }
+footer .wrap { display: flex; flex-wrap: wrap; gap: 12px 28px; justify-content: space-between; }
+footer ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; }
