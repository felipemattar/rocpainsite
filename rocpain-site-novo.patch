+.featured img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 460 / 215; }
+.featured-body { padding: clamp(22px, 3vw, 36px); display: flex; flex-direction: column; justify-content: center; }
+.tag {
+  align-self: flex-start; font-size: .8125rem; font-weight: 700;
+  background: var(--crimson); color: var(--text); padding: 4px 10px; border-radius: 6px; margin-bottom: 14px;
+}
+.game-title {
